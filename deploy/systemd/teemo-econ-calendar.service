[Unit]
Description=Refresh TeemoBKK economic calendar JSON
Wants=network-online.target
After=network-online.target

[Service]
User=teemo
Group=teemo
Type=oneshot
WorkingDirectory=/opt/teemo-live-news
ExecStart=/usr/bin/python3 /opt/teemo-live-news/server/econ_calendar.py /opt/teemo-live-news/docs/calendar.json
TimeoutStartSec=600
