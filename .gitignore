# runtime data and local artefacts
news.db
news.db-wal
news.db-shm
# database copies a swap or a retag leaves behind (see the VPS swap on 2026-09-20)
news.db.retag-*.bak
news.db.bak-*
news.db.replaced-*
news.db.malformed-*
# copies tools/backup_db.py writes (13MB each - never commit one)
news-*.db
news_cache.json
perspectives_cache.json
server.log
stdout.log
stderr.log

# editor backups of the dashboard page
index_backup_*.html
index_new.html
icon_variants/

# python
__pycache__/
*.pyc
# logs
*.log
*.log.err
*.err
*.log.prev
*.log.err.prev

# your original artwork: keep the working copy local, publish only the generated icons
icon-source.png

# cloudflare worker deps
worker/node_modules/
worker/.wrangler/

# page-check harness: jsdom is installed per machine, not committed
tests/node_modules/

# the admin password lives on the host that serves the site, never in the repository
.admin_password

# secret files belong to the host that runs the pusher: its token, channel id and rewrite provider
# key are all in one of these. They are staged on the host by hand and never travel through git -
# the pattern is here so that one `git add -A` on that host cannot commit them.
.env
.env.*

# section pages are generated on the host that serves them
/ko/
/news/
/thai/

# The page the collector answers "/" with is generated per machine and is not a file to commit:
# locally it is the operator page built from this database's rows, on the host it is landing.py plus
# the live post list, so no single copy can be the right one. tests/run.py and
# page_build.build_server() both write it before it is served.
/index.html

# graft's local repository settings — not committed.
/.graft/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
